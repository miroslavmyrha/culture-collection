{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "jsx-a11y",
    "import",
    "vitest",
    "unicorn",
    "oxc"
  ],
  "options": {
    "reportUnusedDisableDirectives": "error"
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/jsx-no-target-blank": "error",
    "react/jsx-no-script-url": "error",
    "react/no-danger": "error",
    "react/jsx-key": "error",
    "react/no-array-index-key": "error",
    "react/no-unstable-nested-components": "error",
    "react/error-boundaries": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": [
      "error",
      {
        "checksVoidReturn": {
          "attributes": false
        }
      }
    ],
    "typescript/only-throw-error": [
      "error",
      {
        "allow": [
          {
            "from": "package",
            "package": "@tanstack/router-core",
            "name": [
              "Redirect",
              "NotFoundError"
            ]
          }
        ]
      }
    ],
    "typescript/switch-exhaustiveness-check": "error",
    "no-console": "error",
    "no-restricted-globals": [
      "error",
      {
        "name": "localStorage",
        "message": "Use lib/storage.ts (preferences only, never tokens)."
      }
    ],
    "no-restricted-properties": [
      "error",
      {
        "object": "window",
        "property": "open",
        "message": "Use openExternal() from lib/safe.ts (noopener)."
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "dompurify",
            "message": "Render HTML only through components/SafeHtml.tsx (lib/sanitize.ts)."
          }
        ],
        "patterns": [
          {
            "group": [
              "@mui/**",
              "@emotion/**"
            ],
            "message": "Import UI components from @/components/ui. Only components/ui and app/ (theme, emotion cache) import MUI and emotion."
          }
        ]
      }
    ],
    "react/react-in-jsx-scope": "off"
  },
  "overrides": [
    {
      "files": [
        "src/features/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "dompurify",
                "message": "Render HTML only through components/SafeHtml.tsx (lib/sanitize.ts)."
              }
            ],
            "patterns": [
              {
                "group": [
                  "@/app/**",
                  "@/pages/**",
                  "@/routes/**"
                ],
                "message": "Features never import the app shell, pages or routes: they import features."
              },
              {
                "group": [
                  "@/features/**"
                ],
                "message": "No feature-to-feature imports. Inside a feature use relative paths; shared code goes to lib/ or components/."
              },
              {
                "group": [
                  "../../**"
                ],
                "message": "Relative import leaves the feature (or nests too deep): use @/lib or @/components, or flatten."
              },
              {
                "group": [
                  "@mui/**",
                  "@emotion/**"
                ],
                "message": "Import UI components from @/components/ui. Only components/ui and app/ (theme, emotion cache) import MUI and emotion."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/features/*/*.ts",
        "src/features/*/*.tsx"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "dompurify",
                "message": "Render HTML only through components/SafeHtml.tsx (lib/sanitize.ts)."
              }
            ],
            "patterns": [
              {
                "group": [
                  "@/app/**",
                  "@/pages/**",
                  "@/routes/**"
                ],
                "message": "Features never import the app shell, pages or routes: they import features."
              },
              {
                "group": [
                  "@/features/**"
                ],
                "message": "No feature-to-feature imports. Inside a feature use relative paths; shared code goes to lib/ or components/."
              },
              {
                "group": [
                  "../**"
                ],
                "message": "A file at the root of a feature has nothing above it but other features: import with ./ inside the feature, never ../."
              },
              {
                "group": [
                  "@mui/**",
                  "@emotion/**"
                ],
                "message": "Import UI components from @/components/ui. Only components/ui and app/ (theme, emotion cache) import MUI and emotion."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/lib/**",
        "src/components/**",
        "src/hooks/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "dompurify",
                "message": "Render HTML only through components/SafeHtml.tsx (lib/sanitize.ts)."
              }
            ],
            "patterns": [
              {
                "group": [
                  "@/app/**",
                  "@/pages/**",
                  "@/routes/**",
                  "@/features/**"
                ],
                "message": "Shared code (lib, components, hooks) never imports the app, pages, routes or features."
              },
              {
                "group": [
                  "@mui/**",
                  "@emotion/**"
                ],
                "message": "Import UI components from @/components/ui. Only components/ui and app/ (theme, emotion cache) import MUI and emotion."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/components/ui/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "dompurify",
                "message": "Render HTML only through components/SafeHtml.tsx (lib/sanitize.ts)."
              }
            ],
            "patterns": [
              {
                "group": [
                  "@/app/**",
                  "@/pages/**",
                  "@/routes/**",
                  "@/features/**"
                ],
                "message": "Shared code (lib, components, hooks) never imports the app, pages, routes or features."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/app/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "dompurify",
                "message": "Render HTML only through components/SafeHtml.tsx (lib/sanitize.ts)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/pages/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "dompurify",
                "message": "Render HTML only through components/SafeHtml.tsx (lib/sanitize.ts)."
              }
            ],
            "patterns": [
              {
                "group": [
                  "@/app/**",
                  "@/routes/**"
                ],
                "message": "Pages compose features; the app shell and routes import pages, not the other way."
              },
              {
                "group": [
                  "@mui/**",
                  "@emotion/**"
                ],
                "message": "Import UI components from @/components/ui. Only components/ui and app/ (theme, emotion cache) import MUI and emotion."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/lib/sanitize.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/app/**",
                  "@/pages/**",
                  "@/routes/**",
                  "@/features/**"
                ],
                "message": "Shared code (lib, components, hooks) never imports the app, pages, routes or features."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/components/SafeHtml.tsx"
      ],
      "rules": {
        "react/no-danger": "off"
      }
    },
    {
      "files": [
        "src/lib/safe.ts"
      ],
      "rules": {
        "no-restricted-properties": "off"
      }
    },
    {
      "files": [
        "src/lib/storage.ts",
        "src/test/**",
        "e2e/**"
      ],
      "rules": {
        "no-restricted-globals": "off"
      }
    }
  ],
  "ignorePatterns": [
    "dist",
    "playwright-report",
    "src/api/schema.d.ts",
    "test-results"
  ]
}
