# Production proxy (#178): TLS, the SPA with a fresh CSP nonce per response, and the API.
# The image's entrypoint renders this file at start (envsubst replaces only the variables set in
# its environment: DJANGO_ADMIN_PATH). nginx variables such as $request_id stay as they are.
#
# The nonce is $request_id: 32 random hex characters per request, the only per-request random
# value nginx has without modules. The same value goes to the API as X-Request-ID.

# HTTP: a redirect to HTTPS, and the container's own health probe.
server {
    listen 8080;
    listen [::]:8080;
    server_tokens off;

    location = /nginx-health {
        access_log off;
        allow 127.0.0.1;
        allow ::1;
        deny all;
        return 204;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    http2 on;
    server_tokens off;

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # The outer line of the body cap; the app refuses the same size itself (REQUEST_MAX_BYTES, #41).
    client_max_body_size 11m;

    root /usr/share/nginx/html;

    # The probes are for the containers, not the internet.
    location = /healthz { return 404; }
    location = /readyz { return 404; }

    location /api/ {
        include /etc/nginx/snippets/backend.conf;
    }

    location /static/ {
        include /etc/nginx/snippets/backend.conf;
    }

    location /${DJANGO_ADMIN_PATH} {
        include /etc/nginx/snippets/backend.conf;
    }

    # Built assets carry a content hash in their names: cache them for a year.
    location /assets/ {
        try_files $uri =404;
        include /etc/nginx/snippets/spa-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # Every other path is a route of the SPA.
    location / {
        try_files $uri /index.html;
        include /etc/nginx/snippets/spa-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    location = /index.html {
        sub_filter_once off;
        sub_filter "__CSP_NONCE__" "$request_id";
        include /etc/nginx/snippets/spa-headers.conf;
        add_header Cache-Control "no-store" always;
    }
}
