# Production settings of deploy/compose.yaml (#178). Copy to deploy/.env. Secrets do not go
# here: deploy/deploy.sh secrets writes them to deploy/secrets/. README "Production" lists
# the optional settings (backend/config/settings/base.py has them all).
DJANGO_ALLOWED_HOSTS=collection.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://collection.example.org
# Not the default admin path: a long random segment, ending with a slash.
DJANGO_ADMIN_PATH=change-me-admin/
# Where fullchain.pem and privkey.pem are, relative to deploy/ or absolute.
TLS_DIR=./certs
LOG_FORMAT=json
# Where the backups go (deploy/backup.sh, docs/runbook.md): off the host, in the EU. Its
# credentials go in secrets/restic_env, not here.
RESTIC_REPOSITORY=s3:https://s3.example.eu/cultures-backup/cultures
# HTTP_PORT=80
# HTTPS_PORT=443
# WEB_SUBNET=10.178.0.0/24 and PROXY_ADDRESS=10.178.0.10 when that range is taken on the host
